    "./page": "./page.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "page.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
