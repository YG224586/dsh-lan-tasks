{
  "name": "@local/dsh-lan-tasks",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "局域网任务看板：在手机浏览器里实时查看 DSH 的会话、任务板、后台作业与活动流水，点进会话看详情、发消息、发图片；桌面 GUI 里也有一块扫码面板。",
  "icon": "./icon.svg",
  "meta": {
    "title": "局域网任务看板",
    "description": "用手机连同一个 Wi-Fi 就能看当前任务干到哪一步了。"
  },
  "exports": {
    ".": "./index.js",
    "./page": "./page.js",
    "./client": "./client.js",
    "./qrcode": "./qrcode.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "page.js",
    "client.js",
    "qrcode.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
